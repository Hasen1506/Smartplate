# Use demo mode only for local sample data and simulated orders.
SMARTPLATE_MODE=demo
SMARTPLATE_DB=smartplate.db

# For public invite-beta, set SMARTPLATE_MODE=production and configure:
# DATABASE_URL=postgresql://...  (Supabase direct or session-pooler connection)
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SMARTPLATE_INVITED_EMAILS=first@example.com,second@example.com
# SMARTPLATE_SESSION_SECRET=long-random-secret
# SMARTPLATE_PUBLIC_BASE_URL=https://smartplate-beta.onrender.com
